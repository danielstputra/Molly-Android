<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_tool_call_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Tool Header (Clickable for Expand/Collapse) -->
    <LinearLayout
        android:id="@+id/llToolHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivToolStatusIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Status Alat"
            android:src="@drawable/ic_tool_check" />

        <ProgressBar
            android:id="@+id/pbToolLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/primary_gold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvToolHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Alat: Jalankan Perintah Shell"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvToolStatusSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Eksekusi berhasil diselesaikan"
                android:textColor="@color/status_green"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvToolBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#2610B981"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="SELESAI"
            android:textColor="@color/status_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivToolChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Expand"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <!-- Expandable Accordion Body -->
    <LinearLayout
        android:id="@+id/llToolBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Command / Argument Panel -->
        <LinearLayout
            android:id="@+id/llCommandContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parameter / Perintah Input:"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvToolCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:text="python main.py"
                android:textColor="#E0E2E6"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Execution Result / Output Panel -->
        <LinearLayout
            android:id="@+id/llOutputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hasil Eksekusi (Output Realtime):"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvToolOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:maxLines="20"
                android:padding="8dp"
                android:text="Output eksekusi terminal..."
                android:textColor="#10B981"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tool Approval Action Bar (Only visible when waiting approval) -->
        <LinearLayout
            android:id="@+id/llApprovalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_code_block"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Alat ini memerlukan izin eksekusi:"
                android:textColor="@color/primary_gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRejectTool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_action_pill"
                android:backgroundTint="#33EF4444"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Tolak"
                android:textColor="@color/status_red"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnApproveTool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_action_pill"
                android:backgroundTint="#3310B981"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Setujui Eksekusi"
                android:textColor="@color/status_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
