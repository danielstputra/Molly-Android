<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tool_call_card"
    android:backgroundTint="#13161A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Modal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Berkas Ruang Kerja (Workspace)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih berkas untuk dijadikan referensi konteks"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseWorkspaceDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Tutup"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_clear"
            android:tint="#9CA3AF" />
    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_code_block"
        android:backgroundTint="#1F242C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etSearchWorkspaceFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="Cari berkas di ruang kerja..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B7280"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Loading Bar -->
    <ProgressBar
        android:id="@+id/pbLoadingWorkspaceFiles"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary_gold"
        android:visibility="gone" />

    <!-- File List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWorkspaceFiles"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyWorkspaceFiles"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="Tidak ada berkas yang cocok di ruang kerja"
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Footer Information -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Tip: Ketuk berkas untuk menyematkan ke pesan chat"
        android:textColor="#6B7280"
        android:textSize="11sp" />

</LinearLayout>
