<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llSessionItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_action_pill"
    android:backgroundTint="#1D2024"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/ivSessionIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Sesi"
        android:src="@drawable/ic_molly_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Percakapan Analisis"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSessionDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Hari ini"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivPinned"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Disematkan"
        android:src="@drawable/ic_pin"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btnSessionOptions"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="Opsi Sesi"
        android:padding="4dp"
        android:src="@drawable/ic_more_vert" />

</LinearLayout>
