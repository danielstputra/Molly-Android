<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_code_block"
    android:backgroundTint="#181B20"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header bar: Version Badge + Tag + Release Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemVersionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#06B6D4"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="v1.2.4"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemVersionTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#1E293B"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="TERBARU"
            android:textColor="@color/primary_gold"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvItemReleaseDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25 Nov 2026"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Version Title -->
    <TextView
        android:id="@+id/tvItemVersionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Judul Versi Pembaruan"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Container for Bullet List of Changes -->
    <LinearLayout
        android:id="@+id/llItemChangesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

</LinearLayout>
