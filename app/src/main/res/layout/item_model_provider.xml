<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_tool_call_card"
    android:backgroundTint="#16191E"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Avatar Emoji, Name, ID, and Enable Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvProviderAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#2638BDF8"
            android:gravity="center"
            android:text="🤖"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProviderDisplayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Antigravity Tools"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProviderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ag-tools • openai"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swProviderEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Second Row: Credential Status & Capabilities -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Credential Badge -->
        <TextView
            android:id="@+id/tvProviderCredential"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#2610B981"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Kredensial Siap"
            android:textColor="@color/status_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Capabilities Summary -->
        <TextView
            android:id="@+id/tvProviderCapabilities"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="chat • embedding"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <!-- Models Count Badge -->
        <TextView
            android:id="@+id/tvProviderModelCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#26F3BA32"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="2 Model Aktif"
            android:textColor="@color/primary_gold"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Base URL preview if present -->
    <TextView
        android:id="@+id/tvProviderBaseUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_code_block"
        android:backgroundTint="#1A1E24"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="http://127.0.0.1:8045/v1"
        android:textColor="#9CA3AF"
        android:textSize="11sp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Kelola Model Button -->
        <LinearLayout
            android:id="@+id/btnManageModels"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#2638BDF8"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Kelola Model"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Konfigurasi Button -->
        <LinearLayout
            android:id="@+id/btnConfigProvider"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#264B5563"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Konfigurasi"
                android:textColor="#D1D5DB"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Hapus Button -->
        <ImageView
            android:id="@+id/btnDeleteProvider"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Hapus Penyedia"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/status_red" />
    </LinearLayout>

</LinearLayout>
