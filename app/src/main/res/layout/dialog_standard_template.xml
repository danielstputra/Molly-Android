<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llStandardDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_dialog"
    android:backgroundTint="#13161A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Title & Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStandardDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Judul Dialog"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnStandardDialogClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Tutup"
            android:padding="6dp"
            android:src="@drawable/ic_clear"
            android:tint="#9CA3AF" />
    </LinearLayout>

    <!-- Header Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#262D35" />

    <!-- Message Text (Default) -->
    <TextView
        android:id="@+id/tvStandardDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:textColor="#9CA3AF"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <!-- Custom View Inset Container -->
    <FrameLayout
        android:id="@+id/flStandardDialogContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Footer Divider -->
    <View
        android:id="@+id/vStandardDialogButtonDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#262D35"
        android:visibility="gone" />

    <!-- Buttons Container -->
    <LinearLayout
        android:id="@+id/llStandardDialogButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnStandardDialogNeutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#20252D"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Opsi"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnStandardDialogNegative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#20252D"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Batal"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnStandardDialogPositive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_widget_submit_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="Simpan"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
