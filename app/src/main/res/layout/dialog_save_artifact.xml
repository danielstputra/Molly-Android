<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_dialog"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_save"
            android:tint="#10B981" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSaveArtifactTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save Artifact"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSaveArtifactSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select directory in personal workspace to save"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseSaveArtifact"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Tutup"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_clear"
            android:tint="#9CA3AF" />
    </LinearLayout>

    <!-- Path Breadcrumb & Actions Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSaveArtifactBreadcrumb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="Workspace /"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnSaveArtifactNewFolder"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#2610B981"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_folder_plus"
                android:tint="#10B981" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Buat folder baru"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSaveArtifactRefresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Refresh"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            android:tint="#9CA3AF" />
    </LinearLayout>

    <!-- Form Buat Folder Baru Inline -->
    <LinearLayout
        android:id="@+id/llCreateFolderRow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_code_block"
        android:backgroundTint="#1F242C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_folder"
            android:tint="#F59E0B" />

        <EditText
            android:id="@+id/etNewFolderName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="nama folder"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B7280"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnConfirmCreateFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="membuat"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCancelCreateFolder"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_clear"
            android:tint="#9CA3AF" />
    </LinearLayout>

    <!-- Loading Bar -->
    <ProgressBar
        android:id="@+id/pbLoadingFolders"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:indeterminateTint="#10B981"
        android:visibility="gone" />

    <!-- Folder List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFolderList"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_code_block"
        android:backgroundTint="#181B20"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:padding="4dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyFolders"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="Direktori saat ini kosong"
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Bottom Buttons: Cancel & Save -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelSaveArtifact"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#26FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirmSaveArtifact"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#10B981"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
