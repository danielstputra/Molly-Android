<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_tool_call_card"
    android:backgroundTint="#1A1E24"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Row: Enable Switch, Model Name & ID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swModelItemEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvModelItemDisplayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="gemini-4-hydrogen-medium"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModelItemId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="gemini-4-hydrogen-medium"
                android:textColor="#9CA3AF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Test Connection Button -->
        <LinearLayout
            android:id="@+id/btnTestModelConnection"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#26F59E0B"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvTestModelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="Uji"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Meta row: Type badge, context length / dimension, and source -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvModelItemType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#2638BDF8"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="Chat"
            android:textColor="#38BDF8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvModelItemMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="1M tokens"
            android:textColor="#9CA3AF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvModelItemSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="• remote"
            android:textColor="#6B7280"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Test result alert if tested -->
    <TextView
        android:id="@+id/tvModelTestResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_code_block"
        android:backgroundTint="#2610B981"
        android:padding="4dp"
        android:text="✓ Model siap &amp; merespon dengan baik"
        android:textColor="@color/status_green"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
