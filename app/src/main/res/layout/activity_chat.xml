<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Chat Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:orientation="vertical">

        <!-- Top Action Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/card_dark"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Tombol Buka Drawer Riwayat Sesi (Menu Hamburger) -->
            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Riwayat Sesi"
                android:padding="8dp"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAgentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Molly Agent"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_agent_bubble"
                        android:backgroundTint="@color/status_green" />

                    <TextView
                        android:id="@+id/tvSyncStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Realtime Sync Web Aktif"
                        android:textColor="@color/status_green"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tombol Clear Chat / Bersihkan Chat -->
            <ImageView
                android:id="@+id/btnClearChat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Bersihkan Chat"
                android:padding="8dp"
                android:src="@drawable/ic_clear" />

            <!-- Tombol Putuskan Molly Agent -->
            <LinearLayout
                android:id="@+id/btnDisconnect"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_action_pill"
                android:backgroundTint="#26EF4444"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Putuskan"
                    android:src="@drawable/ic_disconnect" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Putuskan"
                    android:textColor="@color/status_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chat Messages List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />

        <!-- Agent Thinking Indicator -->
        <LinearLayout
            android:id="@+id/llThinking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="@color/primary_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Molly sedang memproses respon..."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Input Container -->
        <LinearLayout
            android:id="@+id/llInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_input_box"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Tanyakan sesuatu ke Molly..."
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minLines="1"
                android:paddingVertical="4dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <!-- Action Pills Bar and Send Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Switch Agent Pill -->
                        <TextView
                            android:id="@+id/btnSelectAgent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_action_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="+ Asisten Cerdas ⌵"
                            android:textColor="@color/text_white"
                            android:textSize="11sp" />

                        <!-- Switch Tool Approval Pill -->
                        <TextView
                            android:id="@+id/btnSelectApproval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_action_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="kepercayaan penuh ⌵"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <!-- Switch Model & Provider Pill -->
                        <TextView
                            android:id="@+id/btnSelectModel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_action_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="gemini-4-hydrogen-medium ⌵"
                            android:textColor="@color/primary_gold"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Send Button -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Kirim"
                    app:backgroundTint="@color/primary_gold"
                    app:elevation="2dp"
                    app:fabCustomSize="38dp"
                    app:maxImageSize="18dp"
                    app:srcCompat="@drawable/ic_arrow_up"
                    app:tint="#121417" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Side Navigation Drawer for Chat History -->
    <include
        layout="@layout/layout_session_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
