<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Chat Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:orientation="vertical">

        <!-- Top Action Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/card_dark"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Tombol Buka Drawer Riwayat Sesi (Menu Hamburger) -->
            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Riwayat Sesi"
                android:padding="8dp"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAgentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Molly Agent"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_agent_bubble"
                        android:backgroundTint="@color/status_green" />

                    <TextView
                        android:id="@+id/tvSyncStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Realtime Sync Web Aktif"
                        android:textColor="@color/status_green"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tombol Status Token & Context Usage (Pill Status Ringkas) -->
            <LinearLayout
                android:id="@+id/btnContextStatus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_action_pill"
                android:backgroundTint="#2638BDF8"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/tvToolbarContextPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="3dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="#38BDF8" />
            </LinearLayout>

            <!-- Tombol Dokumen / Ruang Kerja (Personal Space & Files) -->
            <ImageView
                android:id="@+id/btnDocuments"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Dokumen &amp; Ruang Kerja"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_folder" />

            <!-- Tombol Clear Chat / Bersihkan Chat -->
            <ImageView
                android:id="@+id/btnClearChat"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Bersihkan Chat"
                android:padding="7dp"
                android:src="@drawable/ic_clear" />

            <!-- Tombol Putuskan Molly Agent (Kompak & Responsif) -->
            <LinearLayout
                android:id="@+id/btnDisconnect"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_action_pill"
                android:backgroundTint="#26EF4444"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:contentDescription="Putuskan">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Putuskan"
                    android:src="@drawable/ic_disconnect" />
            </LinearLayout>
        </LinearLayout>

        <!-- Messages Area with Floating Overlays (Scroll to Bottom & Section Navigator) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Swipe Down to Refresh Chat -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Chat Messages List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMessages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- Segment / Section Navigator Scroller Container (Left Rail + Floating Preview Card) -->
            <FrameLayout
                android:id="@+id/flTimelineNavigatorContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Vertical Scrubber / Rail (Left edge) -->
                <LinearLayout
                    android:id="@+id/llSegmentNavigator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_timeline_rail"
                    android:elevation="8dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone">

                    <!-- Caret / Arrow Up (^) -->
                    <TextView
                        android:id="@+id/btnSegmentPrev"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:text="^"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:contentDescription="Bagian Sebelumnya"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <!-- Top subtle track line / dash -->
                    <View
                        android:id="@+id/lineSegmentTop"
                        android:layout_width="1.5dp"
                        android:layout_height="10dp"
                        android:layout_marginVertical="2dp"
                        android:background="#334155" />

                    <!-- Dynamic Dots Container inside Max-Height ScrollView -->
                    <ScrollView
                        android:id="@+id/svTimelineRail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fadeScrollbars="true"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/llSegmentNodes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical" />
                    </ScrollView>

                    <!-- Bottom subtle track line / dash -->
                    <View
                        android:id="@+id/lineSegmentBottom"
                        android:layout_width="1.5dp"
                        android:layout_height="10dp"
                        android:layout_marginVertical="2dp"
                        android:background="#334155" />

                    <!-- Caret / Arrow Down (v) -->
                    <TextView
                        android:id="@+id/btnSegmentNext"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:text="v"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:contentDescription="Bagian Selanjutnya"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <!-- Floating Preview Card (Matches the screenshot 100%) -->
                <LinearLayout
                    android:id="@+id/cardSegmentPreview"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="36dp"
                    android:layout_marginTop="100dp"
                    android:background="@drawable/bg_timeline_preview_card"
                    android:elevation="14dp"
                    android:orientation="vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <!-- Prompt Title (Bold, White, maxLines=2) -->
                    <TextView
                        android:id="@+id/tvPreviewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#F8FAFC"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <!-- Response Snippet (Muted, maxLines=3) -->
                    <TextView
                        android:id="@+id/tvPreviewSnippet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.15"
                        android:maxLines="3"
                        android:textColor="#94A3B8"
                        android:textSize="11.5sp" />

                    <!-- Bottom Metadata Bar: "247 of 251" and "9:58 AM" -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPreviewCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#64748B"
                            android:textSize="10.5sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvPreviewTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#64748B"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Floating Scroll-to-Bottom Button -->
            <FrameLayout
                android:id="@+id/btnScrollBottom"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_scroll_bottom_fab"
                android:clickable="true"
                android:contentDescription="Scroll ke Bawah"
                android:elevation="6dp"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Panah Bawah"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="#38BDF8" />
            </FrameLayout>

        </FrameLayout>

        <!-- Agent Thinking Indicator -->
        <LinearLayout
            android:id="@+id/llThinking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="@color/primary_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Molly sedang memproses respon..."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Conversation Reading Failed / Reread Banner (Gambar 2) -->
        <LinearLayout
            android:id="@+id/llRereadBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRereadErrorMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conversation reading failed, please try again."
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnRereadConversation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_action_pill"
                android:backgroundTint="#1A38BDF8"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Reread conversation"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="normal" />
        </LinearLayout>

        <!-- Input Container -->
        <LinearLayout
            android:id="@+id/llInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_input_box"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- Attachment Staging Preview Bar (Horizontal Scroll) -->
            <HorizontalScrollView
                android:id="@+id/hsvAttachmentStaging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llAttachmentStagingContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Top Row: Add Button (+) + EditText -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnAddAttachment"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chat_action_btn"
                    android:clickable="true"
                    android:contentDescription="Tambah Konten atau Referensi"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/primary_gold" />

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Tanyakan sesuatu? Gunakan @ untuk referensi..."
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:minLines="1"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Action Pills Bar and Send Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Switch Agent Pill -->
                        <TextView
                            android:id="@+id/btnSelectAgent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_action_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="+ Asisten Cerdas ⌵"
                            android:textColor="@color/text_white"
                            android:textSize="11sp" />

                        <!-- Switch Tool Approval Pill -->
                        <TextView
                            android:id="@+id/btnSelectApproval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_action_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="kepercayaan penuh ⌵"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <!-- Switch Model & Provider Pill -->
                        <TextView
                            android:id="@+id/btnSelectModel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_action_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="gemini-4-hydrogen-medium ⌵"
                            android:textColor="@color/primary_gold"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Send Button -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Kirim"
                    app:backgroundTint="@color/primary_gold"
                    app:elevation="2dp"
                    app:fabCustomSize="38dp"
                    app:maxImageSize="18dp"
                    app:srcCompat="@drawable/ic_arrow_up"
                    app:tint="#121417" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Side Navigation Drawer for Chat History -->
    <include
        layout="@layout/layout_session_drawer"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
