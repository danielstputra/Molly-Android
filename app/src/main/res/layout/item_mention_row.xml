<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Group Header (Skills, Agents, Files) -->
    <TextView
        android:id="@+id/tvMentionGroupHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:text="Skills"
        android:textColor="#9CA3AF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Mention Item Row -->
    <LinearLayout
        android:id="@+id/llMentionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="2dp"
        android:background="@drawable/bg_code_block"
        android:backgroundTint="#16191E"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvMentionIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_chat_action_btn"
            android:gravity="center"
            android:text="🤹"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMentionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riset Mendalam"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMentionDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Metodologi orkestrasi riset mendalam..."
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMentionTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#1A38BDF8"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Skill"
            android:textColor="#38BDF8"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
