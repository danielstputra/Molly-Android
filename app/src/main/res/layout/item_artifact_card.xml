<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llArtifactCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_artifact_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Icon Badge -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_chat_action_btn"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivArtifactIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Tipe Berkas"
            android:src="@drawable/ic_globe"
            app:tint="#10B981" />
    </FrameLayout>

    <!-- Meta Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvArtifactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="login.html"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvArtifactMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Artifact File · HTML"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Actions (Download & Save) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnDownloadArtifact"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chat_action_btn"
            android:clickable="true"
            android:contentDescription="Unduh Berkas"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_download"
            app:tint="#94A3B8" />

        <ImageView
            android:id="@+id/btnSaveArtifact"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_action_btn"
            android:clickable="true"
            android:contentDescription="Simpan ke Ruang Kerja"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_save"
            app:tint="#94A3B8" />
    </LinearLayout>

</LinearLayout>
