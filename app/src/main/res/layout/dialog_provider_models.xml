<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_dialog"
    android:backgroundTint="#13161A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Title and Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvModelsDialogAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#2638BDF8"
            android:gravity="center"
            android:text="🤖"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvModelsDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Kelola Model: OpenAI"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModelsDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atur model yang diaktifkan untuk obrolan &amp; agen"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnModelsDialogClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Tutup"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_clear"
            android:tint="#9CA3AF" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#262D35" />

    <!-- Action Bar: Fetch Remote & Add Manual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnFetchRemoteModels"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#2638BDF8"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFetchRemoteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Tarik Model Remote"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAddManualModel"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#26F3BA32"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➕"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Tambah Manual"
                android:textColor="@color/primary_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search Model Bar -->
    <EditText
        android:id="@+id/etSearchModelDialog"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_code_block"
        android:backgroundTint="#1A1E24"
        android:hint="Cari model id atau nama..."
        android:paddingHorizontal="10dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#4B5563"
        android:textSize="12sp" />

    <!-- Type Filter Tabs: Semua, Chat, Embedding, Rerank -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabModelTypeAll"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#33F3BA32"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Semua"
            android:textColor="@color/primary_gold"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabModelTypeChat"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#1A1E24"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Chat"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tabModelTypeEmbedding"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#1A1E24"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Embedding"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tabModelTypeRerank"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#1A1E24"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Rerank"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Progress loading spinner -->
    <ProgressBar
        android:id="@+id/pbModelDialogLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="24dp"
        android:indeterminateTint="@color/primary_gold"
        android:visibility="gone" />

    <!-- Models Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDialogModels"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyDialogModels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp"
        android:gravity="center"
        android:text="Belum ada model yang diaktifkan untuk penyedia ini."
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Footer Save Changes Button -->
    <TextView
        android:id="@+id/btnSaveDialogModels"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_action_pill"
        android:backgroundTint="@color/primary_gold"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Simpan Model yang Diaktifkan"
        android:textColor="#121417"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
