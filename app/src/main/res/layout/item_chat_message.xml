<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- User Message Container (Aligned Right) -->
    <LinearLayout
        android:id="@+id/llUserContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_user_bubble"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <!-- Container Lampiran Pesan Pengguna (Foto, Dokumen, Audio, Video) -->
            <LinearLayout
                android:id="@+id/llUserAttachments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvUserMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User message"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <!-- Container untuk Widgets / Tables pada pesan user -->
            <LinearLayout
                android:id="@+id/llUserWidgets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvUserTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:text="12:00"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Agent Message Container (Aligned Left) -->
    <LinearLayout
        android:id="@+id/llAgentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivAgentAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Avatar Molly"
            android:src="@drawable/ic_molly_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <!-- Bubble Agent -->
            <LinearLayout
                android:id="@+id/llAgentBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_agent_bubble"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/tvAgentMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="Agent response..."
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <!-- Container untuk Rich Widgets, Code Blocks dengan tombol Menyalin, Prompt Cards, dan Forms -->
                <LinearLayout
                    android:id="@+id/llAgentWidgets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Container Kartu Artefak (Present Artifacts: HTML, dokumen, code) -->
            <LinearLayout
                android:id="@+id/llAgentArtifacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Agent Action Bar (Like, Dislike, Copy, Timestamp) Sesuai Gambar -->
            <LinearLayout
                android:id="@+id/llAgentActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Thumbs Up -->
                <ImageView
                    android:id="@+id/btnThumbUp"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_chat_action_btn"
                    android:clickable="true"
                    android:contentDescription="Suka"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_thumb_up" />

                <!-- Thumbs Down -->
                <ImageView
                    android:id="@+id/btnThumbDown"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chat_action_btn"
                    android:clickable="true"
                    android:contentDescription="Tidak Suka"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_thumb_down" />

                <!-- Copy -->
                <ImageView
                    android:id="@+id/btnCopyMessage"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chat_action_btn"
                    android:clickable="true"
                    android:contentDescription="Salin Pesan"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_copy" />

                <!-- Timestamp -->
                <TextView
                    android:id="@+id/tvAgentTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="09:21"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
