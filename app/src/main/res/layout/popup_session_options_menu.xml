<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_session_context_menu"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Option: Pin to top -->
    <LinearLayout
        android:id="@+id/llPopupPin"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:id="@+id/ivPopupPinIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Pin"
            android:src="@drawable/ic_menu_pin" />

        <TextView
            android:id="@+id/tvPopupPinText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="pin to top"
            android:textColor="#ECEFF1"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Option: Rename -->
    <LinearLayout
        android:id="@+id/llPopupRename"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:id="@+id/ivPopupRenameIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Rename"
            android:src="@drawable/ic_menu_rename" />

        <TextView
            android:id="@+id/tvPopupRenameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Rename"
            android:textColor="#ECEFF1"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Option: Archive -->
    <LinearLayout
        android:id="@+id/llPopupArchive"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:id="@+id/ivPopupArchiveIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Archive"
            android:src="@drawable/ic_menu_archive" />

        <TextView
            android:id="@+id/tvPopupArchiveText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Archive"
            android:textColor="#ECEFF1"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="3dp"
        android:background="#262D35" />

    <!-- Option: Delete -->
    <LinearLayout
        android:id="@+id/llPopupDelete"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Hapus"
            android:src="@drawable/ic_menu_delete" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Hapus Sesi"
            android:textColor="#EF4444"
            android:textSize="13.5sp" />
    </LinearLayout>

</LinearLayout>
