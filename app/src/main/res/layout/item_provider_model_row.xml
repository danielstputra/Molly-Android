<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_tool_call_card"
    android:backgroundTint="#16191E"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Row: Switch, Model Name/ID, Type Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swModelRowEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvModelRowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="gemini-4-hydrogen-medium"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModelRowId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="gemini-4-hydrogen-medium"
                android:textColor="#6B7280"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Type Badge -->
        <TextView
            android:id="@+id/tvModelRowType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#2638BDF8"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Chat"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Row: Meta description, Test connection button, Test result -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvModelRowMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="1M tokens"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />

        <!-- Status Result indicator -->
        <TextView
            android:id="@+id/tvModelRowTestBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Tersedia"
            android:textColor="@color/status_green"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- Test Connection Button -->
        <TextView
            android:id="@+id/btnTestModelConnection"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#26F59E0B"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="⚡ Uji"
            android:textColor="#F59E0B"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
