<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tool_call_card"
    android:backgroundTint="#13161A"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Molly Logo"
            android:src="@drawable/ic_molly_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 Catatan Rilis (Changelog)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChangelogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Memuat versi aplikasi..."
                android:textColor="@color/primary_gold"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbChangelogLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary_gold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#242830" />

    <!-- Scrollable Changelog List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="420dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/llChangelogVersionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/llChangelogActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnChangelogClose"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Tutup"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnChangelogUpdateNow"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="@color/primary_gold"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="⚡ Unduh Pembaruan"
            android:textColor="#121417"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
