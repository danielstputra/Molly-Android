<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/bg_dark"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="28dp">

    <!-- Header Drawer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Molly"
            android:src="@drawable/ic_molly_logo" />

        <TextView
            android:id="@+id/tvDrawerHeaderRecent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Recent ⌵"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnRefreshSessions"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Perbarui Riwayat"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- Tombol + Sesi Baru (New Session) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDrawerNewSession"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:text="+ Sesi Chat Baru"
        android:textColor="#121417"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_gold"
        app:cornerRadius="24dp" />

    <!-- Tab Filter Sesi: Aktif vs Arsip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_action_pill"
        android:backgroundTint="@color/card_dark"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tabActiveSessions"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#33F3BA32"
            android:gravity="center"
            android:text="Aktif"
            android:textColor="@color/primary_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabArchivedSessions"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="Arsip"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Recycler View Daftar Sesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDrawerSessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />

    <!-- Empty State Text -->
    <TextView
        android:id="@+id/tvEmptySessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Belum ada sesi percakapan"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Footer Drawer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark" />

    <!-- Menu Berkas Ruang Kerja (Workspace Files - Video 2) -->
    <LinearLayout
        android:id="@+id/btnDrawerWorkspaceFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Berkas Ruang Kerja (Workspace)"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buka ❯"
            android:textColor="@color/primary_gold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Menu Tugas Terjadwal (Task Scheduler) -->
    <LinearLayout
        android:id="@+id/btnDrawerScheduler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Tugas Terjadwal (Scheduler)"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kelola ❯"
            android:textColor="@color/primary_gold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Menu Penyedia Model AI (AI Providers) -->
    <LinearLayout
        android:id="@+id/btnDrawerProviders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧩"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Penyedia Model AI (Providers)"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Katalog ❯"
            android:textColor="@color/primary_gold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Menu Status Penggunaan Token & Konteks -->
    <LinearLayout
        android:id="@+id/btnDrawerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Status Token &amp; Konteks"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDrawerStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--% ❯"
            android:textColor="#38BDF8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Menu Konfigurasi URL Server -->
    <LinearLayout
        android:id="@+id/btnDrawerServerConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Konfigurasi URL Server"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDrawerServerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubah ❯"
            android:textColor="@color/primary_gold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Menu Periksa Pembaruan Aplikasi (Auto-Update) -->
    <LinearLayout
        android:id="@+id/btnDrawerCheckUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Periksa Pembaruan"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDrawerUpdateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cek ❯"
            android:textColor="@color/primary_gold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Menu Catatan Rilis & Changelog Realtime -->
    <LinearLayout
        android:id="@+id/btnDrawerChangelog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📜"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Catatan Rilis (Changelog)"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDrawerChangelogBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.2.4 ❯"
            android:textColor="#06B6D4"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Menu Tentang Aplikasi -->
    <LinearLayout
        android:id="@+id/btnDrawerAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ℹ️"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Tentang Aplikasi"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.6 ❯"
            android:textColor="@color/primary_gold"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDrawerFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:text="Molly Agent Ecosystem • Daniels Trysyahputra"
        android:textColor="#5A5E64"
        android:textSize="10sp" />

</LinearLayout>
