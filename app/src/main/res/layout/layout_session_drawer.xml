<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/bg_dark"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="28dp">

    <!-- Header Drawer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Molly"
            android:src="@drawable/ic_molly_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Riwayat Percakapan"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tombol + Sesi Baru (New Session) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDrawerNewSession"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:text="+ Sesi Chat Baru"
        android:textColor="#121417"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_gold"
        app:cornerRadius="24dp" />

    <!-- Tab Filter Sesi: Aktif vs Arsip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_action_pill"
        android:backgroundTint="@color/card_dark"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tabActiveSessions"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_action_pill"
            android:backgroundTint="#33F3BA32"
            android:gravity="center"
            android:text="Aktif"
            android:textColor="@color/primary_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabArchivedSessions"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="Arsip"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Recycler View Daftar Sesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDrawerSessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />

    <!-- Empty State Text -->
    <TextView
        android:id="@+id/tvEmptySessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Belum ada sesi percakapan"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Footer Drawer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark" />

    <TextView
        android:id="@+id/tvDrawerFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="Sesi Tersinkronisasi dengan Molly Web"
        android:textColor="#5A5E64"
        android:textSize="11sp" />

</LinearLayout>
