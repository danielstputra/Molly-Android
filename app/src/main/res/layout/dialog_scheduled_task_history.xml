<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_dialog"
    android:backgroundTint="#13161A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Title, Subtitle, and Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕒 Riwayat Eksekusi"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistoryTaskName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nama Tugas"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnRefreshHistory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Refresh Riwayat"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            android:tint="#9CA3AF" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#262D35" />

    <!-- Loading Bar -->
    <ProgressBar
        android:id="@+id/pbHistoryLoading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="24dp"
        android:indeterminateTint="@color/primary_gold" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp"
        android:gravity="center"
        android:text="Belum ada catatan eksekusi untuk tugas ini."
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Recycler View List of Runs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoryRuns"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Footer Close Button -->
    <TextView
        android:id="@+id/btnCloseHistory"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_action_pill"
        android:backgroundTint="#2638BDF8"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Tutup"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
